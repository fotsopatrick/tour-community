<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aperçu greffé sur la fiche app.
         site_url existe déjà dans la vue parente : ne pas le redéclarer ici,
         Odoo refuse un champ en double dans une même vue.
         Le cadre est flottant à droite : le contenu (onglets Fait / Reste /
         Site) s'écoule à sa gauche, comme demandé. -->
    <record id="view_app_suivi_form_apercu" model="ir.ui.view">
        <field name="name">app.suivi.form.apercu</field>
        <field name="model">app.suivi</field>
        <field name="inherit_id" ref="suivi_apps.app_suivi_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@class='oe_title']" position="after">
                <div style="float:right;margin:0 0 1rem 1.5rem;">
                    <field name="nb_captures" invisible="1"/>
                    <field name="apercu_html" nolabel="1" readonly="1"
                           invisible="nb_captures == 0"/>
                </div>
            </xpath>

            <!-- Gestion : liens de distribution et captures, rangés dans un
                 onglet pour ne pas encombrer la fiche. -->
            <xpath expr="//notebook" position="inside">
                <page string="📱 Aperçu et liens" name="apercu">
                    <group>
                        <field name="apk_url" widget="url"
                               placeholder="https://…/MonApp.apk"/>
                        <field name="format_apercu"/>
                    </group>
                    <field name="capture_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="image" widget="image"
                                   options="{'size': [90, 180]}"/>
                            <field name="name" placeholder="Ce que montre l'écran"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
