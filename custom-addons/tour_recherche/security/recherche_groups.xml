<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Les cercles existent aussi comme groupes Odoo : sinon la règle
             ne vaudrait que pour le code, et l'écran montrerait tout à tout
             le monde. Un garde qui ne tient que dans le code laisse une
             porte ouverte par l'interface.

             Pas d'héritage entre les deux groupes : les règles d'accès
             s'additionnent déjà (voir recherche_rules.xml), et le groupe
             qui hérite déclenchait une erreur Odoo sur le type
             d'utilisateur. Le résultat est le même, sans le piège. -->

        <record id="group_recherche_cercle2" model="res.groups">
            <field name="name">Où chercher — cercle 2 (les agents)</field>
            <field name="comment">Voit les endroits des cercles 2, 3 et 4. Jamais le cercle 1.</field>
        </record>

        <record id="group_recherche_cercle1" model="res.groups">
            <field name="name">Où chercher — cercle 1 (le cercle fermé)</field>
            <field name="comment">Patrick, Raphaël, opencode. Voit tous les endroits.</field>
        </record>

    </data>
</odoo>
