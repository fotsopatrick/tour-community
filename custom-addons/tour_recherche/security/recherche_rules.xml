<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Les règles de plusieurs groupes s'additionnent (OU). Chacune
             ouvre donc son cercle et les suivants ; personne ne descend
             sous le sien. L'administrateur passe au-dessus des règles :
             c'est voulu, c'est le poste de Patrick. -->

        <record id="rule_source_cercle4" model="ir.rule">
            <field name="name">Endroits : un utilisateur ordinaire ne voit que le cercle 4</field>
            <field name="model_id" ref="model_recherche_source"/>
            <field name="domain_force">[('cercle', '&gt;=', '4')]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_source_cercle2" model="ir.rule">
            <field name="name">Endroits : les agents voient les cercles 2, 3 et 4</field>
            <field name="model_id" ref="model_recherche_source"/>
            <field name="domain_force">[('cercle', '&gt;=', '2')]</field>
            <field name="groups" eval="[(4, ref('group_recherche_cercle2'))]"/>
        </record>

        <record id="rule_source_cercle1" model="ir.rule">
            <field name="name">Endroits : le cercle fermé voit tout</field>
            <field name="model_id" ref="model_recherche_source"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_recherche_cercle1'))]"/>
        </record>

        <!-- Le journal suit l'endroit : on ne lit pas la trace d'une fouille
             dans un endroit qu'on n'a pas le droit de voir. -->
        <record id="rule_passage_cercle4" model="ir.rule">
            <field name="name">Journal : un utilisateur ordinaire ne voit que le cercle 4</field>
            <field name="model_id" ref="model_recherche_passage"/>
            <field name="domain_force">[('source_id.cercle', '&gt;=', '4')]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_passage_cercle2" model="ir.rule">
            <field name="name">Journal : les agents voient les cercles 2, 3 et 4</field>
            <field name="model_id" ref="model_recherche_passage"/>
            <field name="domain_force">[('source_id.cercle', '&gt;=', '2')]</field>
            <field name="groups" eval="[(4, ref('group_recherche_cercle2'))]"/>
        </record>

        <record id="rule_passage_cercle1" model="ir.rule">
            <field name="name">Journal : le cercle fermé voit tout</field>
            <field name="model_id" ref="model_recherche_passage"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_recherche_cercle1'))]"/>
        </record>

    </data>
</odoo>
