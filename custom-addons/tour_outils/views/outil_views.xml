<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tour_outil_list" model="ir.ui.view">
        <field name="name">tour.outil.list</field>
        <field name="model">tour.outil</field>
        <field name="arch" type="xml">
            <list string="Outils">
                <field name="name"/>
                <field name="resume"/>
                <field name="categorie"/>
                <field name="plateforme" optional="show"/>
                <field name="fichier" filename="fichier_nom" widget="binary" string="Télécharger"/>
                <field name="fichier_nom" column_invisible="1"/>
                <field name="interne" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tour_outil_form" model="ir.ui.view">
        <field name="name">tour.outil.form</field>
        <field name="model">tour.outil</field>
        <field name="arch" type="xml">
            <form string="Outil">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Détecteur de surveillance"/></h1>
                        <field name="resume" placeholder="En une phrase : ce que fait l'outil."/>
                    </div>
                    <group>
                        <group>
                            <field name="categorie"/>
                            <field name="plateforme"/>
                            <field name="fichier" filename="fichier_nom" string="Télécharger"/>
                            <field name="fichier_nom" invisible="1"/>
                        </group>
                        <group>
                            <field name="commande"/>
                            <field name="emplacement_repo"/>
                            <field name="interne"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <field name="description" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tour_outil_search" model="ir.ui.view">
        <field name="name">tour.outil.search</field>
        <field name="model">tour.outil</field>
        <field name="arch" type="xml">
            <search string="Chercher un outil">
                <field name="name" string="Chercher"
                       filter_domain="['|','|',
                                       ('name','ilike',self),
                                       ('resume','ilike',self),
                                       ('description','ilike',self)]"/>
                <filter name="f_poste" string="Scripts de poste"
                        domain="[('categorie','=','poste')]"/>
                <filter name="f_serveur" string="Scripts serveur"
                        domain="[('categorie','=','serveur')]"/>
                <filter name="f_mobile" string="Applications mobiles"
                        domain="[('categorie','=','mobile')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="g_cat" string="Catégorie" context="{'group_by': 'categorie'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tour_outil" model="ir.actions.act_window">
        <field name="name">Outils</field>
        <field name="res_model">tour.outil</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tour_outil_search"/>
        <field name="context">{'search_default_g_cat': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun outil pour l'instant</p>
            <p>La boîte à outils de la tour : chaque fiche porte le fichier à
               télécharger et son mode d'emploi.</p>
        </field>
    </record>

    <!-- Règle : ce qui est marqué « interne » ne sort pas de chez l'admin. -->
    <record id="rule_tour_outil_public" model="ir.rule">
        <field name="name">Outils : masquer les fiches internes</field>
        <field name="model_id" ref="model_tour_outil"/>
        <field name="domain_force">[('interne', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_tour_outil_admin" model="ir.rule">
        <field name="name">Outils : tout pour les administrateurs</field>
        <field name="model_id" ref="model_tour_outil"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <menuitem id="menu_outils_racine" name="Outils" sequence="82"
              web_icon="tour_outils,static/description/icon.svg"/>
    <menuitem id="menu_outils" name="La boîte à outils"
              parent="menu_outils_racine" action="action_tour_outil"/>
</odoo>
