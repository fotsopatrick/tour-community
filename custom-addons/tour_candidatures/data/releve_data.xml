<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Une fois par heure. Pas plus : une réponse de recruteur n'arrive
             pas à la minute près, et interroger une boîte trop souvent finit
             par se faire fermer la porte. -->
        <record id="cron_relever_boite" model="ir.cron">
            <field name="name">Candidatures — relever la boîte</field>
            <field name="model_id" ref="model_candidature_fiche"/>
            <field name="state">code</field>
            <field name="code">model._cron_relever_la_boite()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
