<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="depot_note_view_list" model="ir.ui.view">
        <field name="name">depot.note.list</field>
        <field name="model">depot.note</field>
        <field name="arch" type="xml">
            <!-- La dernière déposée en premier. La liste porte le MÊME ordre
                 que le modèle : sans `default_order` explicite ici, une vue
                 peut classer autrement que `_order` et l'écran contredit la
                 base. Voir le commentaire de `_order` dans depot_note.py. -->
            <list default_order="create_date desc, id desc"
                  decoration-warning="doublon_id != False"
                  decoration-muted="traite == False">
                <field name="create_date" string="Déposée" optional="show"/>
                <field name="write_date" string="Modifié" optional="hide"/>
                <field name="name" string="Titre"/>
                <field name="categorie" optional="show"/>
                <field name="resume_ia" string="Résumé" optional="show"/>
                <field name="doublon_id" string="Doublon de" optional="show"/>
                <field name="traite" string="Rangée" widget="boolean_toggle" optional="show"/>
                <field name="source" optional="hide"/>
                <field name="message_attachment_count" string="Fichiers" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="depot_note_view_form" model="ir.ui.view">
        <field name="name">depot.note.form</field>
        <field name="model">depot.note</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Titre (obligatoire, le reste est libre)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source" placeholder="ex : collé depuis WhatsApp, import bureau…"/>
                            <field name="categorie"/>
                        </group>
                        <group>
                            <field name="resume_ia"/>
                            <field name="doublon_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Détail">
                            <field name="contenu" placeholder="Balance ton texte ici — brut, sans mise en forme. Les fichiers se glissent-déposent dans le fil en bas."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="depot_note_action" model="ir.actions.act_window">
        <field name="name">Dépôt</field>
        <field name="res_model">depot.note</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Boîte vide</p>
            <p>Balance ici ce qui n'a pas encore de place : un texte collé,
               une note, un fichier (glisser-déposer dans le fil d'une fiche).
               Le Copilote sait chercher dedans.</p>
        </field>
    </record>

    <menuitem id="menu_depot_root" name="Dépôt" sequence="4"
              web_icon="tour_depot,static/description/icon.svg"/>
    <menuitem id="menu_depot_notes" name="La boîte" parent="menu_depot_root"
              action="depot_note_action" sequence="1"/>

</odoo>
