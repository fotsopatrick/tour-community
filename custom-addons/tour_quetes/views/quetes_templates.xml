<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="page_quetes" name="Quêtes de carrière">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'lang': 'fr-FR'}"/>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Quêtes de carrière</title>
                <style>
                    body { background:var(--fond); color:var(--texte); margin:0;
                           font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
                    .qa { max-width:980px; margin:0 auto; padding:20px 16px 80px; }
                    a.ret { color:#3b82f6; text-decoration:none; font-size:.88rem; }
                    .tete { display:flex; align-items:center; gap:14px; margin:14px 0 4px; flex-wrap:wrap; }
                    .tete h1 { margin:0; font-size:1.7rem; }
                    .sous { color:#94a3b8; font-size:.92rem; margin:0 0 20px; }
                    .xp { margin-left:auto; text-align:right; background:#0f172a;
                          border:1px solid #1e293b; border-radius:.7rem; padding:10px 16px; }
                    .xp b { font-size:1.25rem; color:#3b82f6; line-height:1; }
                    .xp span { color:#64748b; font-size:.75rem; }
                    h2 { font-size:.75rem; text-transform:uppercase; letter-spacing:.09em;
                         color:#64748b; margin:34px 0 12px; font-weight:600; }
                    .carte { background:#0f172a; border:1px solid #1e293b;
                             border-radius:.7rem; padding:16px; margin-bottom:12px; }
                    .grille { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:12px; }
                    .domaine { background:#0f172a; border:1px solid #1e293b; border-radius:.7rem;
                               padding:14px; text-align:center; }
                    .domaine .em { font-size:1.7rem; }
                    .domaine b { display:block; margin-top:4px; }
                    .domaine .c { color:#64748b; font-size:.78rem; }
                    .guilde { background:#0f172a; border:1px solid #1e293b; border-radius:.7rem; padding:16px; }
                    .guilde .ent { display:flex; align-items:center; gap:10px; }
                    .guilde .ent .em { font-size:1.6rem; }
                    .guilde .ent b { font-size:1.05rem; }
                    .guilde p { color:#94a3b8; font-size:.88rem; margin:8px 0; }
                    .membres { color:#64748b; font-size:.78rem; }
                    .q { display:flex; align-items:flex-start; gap:12px; padding:12px 0;
                         border-top:1px solid #1e293b; }
                    .q:first-of-type { border-top:0; }
                    .q .signe { font-size:1.2rem; width:1.4rem; text-align:center; flex:0 0 auto; }
                    .q.faite .signe { color:#22c55e; }
                    .q.en_cours .signe { color:#f59e0b; }
                    .q .corps { flex:1; min-width:0; }
                    .q .corps b { display:block; }
                    .q.faite .corps b { color:#64748b; }
                    .q .desc { color:#94a3b8; font-size:.85rem; margin-top:2px; }
                    .q .tags { margin-top:6px; display:flex; gap:6px; flex-wrap:wrap; }
                    .tag { font-size:.72rem; padding:2px 9px; border-radius:999px;
                           background:#1e293b; color:#cbd5e1; }
                    .tag.skill { background:rgba(59,130,246,.15); color:#93c5fd; }
                    .tag.dom { background:rgba(139,92,246,.15); color:#c4b5fd; }
                    .tag.xp { background:rgba(245,158,11,.12); color:#fcd34d; }
                    .q .act { flex:0 0 auto; display:flex; gap:6px; }
                    .btn { border:0; border-radius:.5rem; padding:6px 12px; font-size:.8rem;
                           font-weight:600; cursor:pointer; color:var(--texte); background:#1e293b; }
                    .btn:hover { filter:brightness(1.2); }
                    .btn.ok { background:#16a34a; }
                    .btn.go { background:#f59e0b; color:#111827; }
                    .btn.off { background:#334155; }
                    form.inl { display:inline; }
                    textarea { width:100%; min-height:120px; background:#0f172a; color:var(--texte);
                               border:1px solid #1e293b; border-radius:.6rem; padding:12px;
                               font-family:inherit; font-size:.9rem; }
                    input[type=text] { width:100%; background:#0f172a; color:var(--texte);
                               border:1px solid #1e293b; border-radius:.6rem; padding:10px 12px;
                               font-family:inherit; font-size:.9rem; margin-bottom:8px; }
                    .btn.big { padding:11px 20px; font-size:.9rem; background:#3b82f6; color:#fff; }
                    .offre { border-left:3px solid #3b82f6; }
                    .offre .cou { color:#22c55e; font-size:.8rem; font-weight:700; }
                    .vide { color:#64748b; font-size:.9rem; padding:14px 0; }
                </style>
<style>
:root{--fond:#020817;--surface:#0f172a;--surface2:#1e293b;--primaire:#3b82f6;--texte:#e2e8f0;--doux:#94a3b8;--alerte:#f59e0b;--ok:#22c55e;--r:.5rem;}
:root[data-theme="light"]{--fond:#EAEEF2;--surface:#FFFFFF;--surface2:#DDE4EB;--primaire:#2F6FB0;--texte:#14202B;--doux:#5C6B7A;--alerte:#B5651D;--ok:#1F8A46;--r:.5rem;}
</style>
<script>
(function(){var k="tour-theme",r=document.documentElement;try{var s=localStorage.getItem(k);if(s==="light"||s==="dark"){r.setAttribute("data-theme",s);}else{r.setAttribute("data-theme","light");}}catch(e){}var b=document.getElementById("themebtn");if(b){b.addEventListener("click",function(){var c=r.getAttribute("data-theme");if(!c){c="light";}var n=c==="dark"?"light":"dark";r.setAttribute("data-theme",n);try{localStorage.setItem(k,n);}catch(e){}});}})();
</script>

            </t>
                <div class="qa">
                    <a class="ret" href="/odoo/apps">← Retour à la tour</a>

                    <div class="tete">
                        <h1>⚔️ Quêtes de carrière</h1>
                        <div class="xp">
                            <b t-esc="xp['valeur']"/> <span>quêtes faites · <t t-esc="xp['xp']"/> XP</span>
                        </div>
                    </div>
                    <p class="sous">Une offre collée devient un registre de quêtes : chaque compétence
                        demandée reçoit sa quête « Maîtrise — X ». Aucune skill de l'annonce n'est laissée de côté.</p>

                    <h2>🎫 Coller une offre</h2>
                    <form class="carte" method="post" action="/tour/quetes/generer">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="text" name="poste" placeholder="Le poste (ex. Développeur full-stack)"/>
                        <input type="text" name="entreprise" placeholder="L'entreprise (facultatif)"/>
                        <textarea name="texte" placeholder="Colle ici le texte complet de l'offre…"></textarea>
                        <div style="text-align:right;margin-top:10px">
                            <button class="btn big" type="submit">⚡ Générer les quêtes</button>
                        </div>
                    </form>

                    <h2>📜 Les offres transformées</h2>
                    <t t-if="offres">
                        <t t-foreach="offres" t-as="o">
                            <div class="carte offre" t-attf-id="offre-#{o['id']}">
                                <b t-esc="o['name']"/>
                                <t t-if="o['entreprise']"> <span style="color:#94a3b8" t-esc="' · ' + o['entreprise']"/></t>
                                <div class="cou" t-esc="o['couverture']"/>
                                <div class="tags">
                                    <t t-foreach="o['skills']" t-as="s">
                                        <span class="tag skill" t-esc="s"/>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="vide">Aucune offre encore. Colle-en une ci-dessus.</div>
                    </t>

                    <h2>🎡 La roue des domaines</h2>
                    <div class="grille">
                        <t t-foreach="domaines" t-as="d">
                            <div class="domaine">
                                <div class="em" t-esc="d['emoji']"/>
                                <b t-esc="d['name']"/>
                                <div class="c" t-esc="str(d['nb_quetes']) + ' en cours · ' + str(d['nb_faites']) + ' faites'"/>
                            </div>
                        </t>
                    </div>

                    <h2>🛡️ Les guildes</h2>
                    <div class="grille">
                        <t t-foreach="guildes" t-as="g">
                            <div class="guilde">
                                <div class="ent"><span class="em" t-esc="g['embleme']"/><b t-esc="g['name']"/></div>
                                <p t-if="g['objectif']" t-esc="g['objectif']"/>
                                <div class="membres">
                                    <t t-foreach="g['membres']" t-as="m"><span t-esc="m"/><t t-if="not m_last">, </t></t>
                                    <t t-if="not g['membres']">(aucun membre assigné)</t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <h2>📖 Le registre des quêtes</h2>
                    <t t-if="quetes">
                        <t t-foreach="quetes" t-as="q">
                            <div class="q" t-att-class="'q ' + q['etat']">
                                <div class="signe" t-esc="q['etat_signe']"/>
                                <div class="corps">
                                    <b t-esc="q['name']"/>
                                    <div class="desc" t-if="q['description']" t-esc="q['description']"/>
                                    <div class="tags">
                                        <span class="tag xp" t-esc="'+' + str(q['xp']) + ' XP'"/>
                                        <t t-if="q['skill']"><span class="tag skill" t-esc="'skill : ' + q['skill']"/></t>
                                        <t t-if="q['domaine']"><span class="tag dom" t-esc="q['domaine']"/></t>
                                        <t t-if="q['guilde']"><span class="tag" t-esc="q['guilde']"/></t>
                                        <t t-if="q['offre']"><span class="tag" t-esc="'offre : ' + q['offre']"/></t>
                                    </div>
                                </div>
                                <div class="act">
                                    <t t-if="q['etat'] == 'a_faire'">
                                        <form class="inl" method="post" action="/tour/quetes/en_cours">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="quete_id" t-att-value="q['id']"/>
                                            <button class="btn go" type="submit">Lancer</button>
                                        </form>
                                    </t>
                                    <t t-if="q['etat'] != 'faite'">
                                        <form class="inl" method="post" action="/tour/quetes/terminer">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="quete_id" t-att-value="q['id']"/>
                                            <button class="btn ok" type="submit">Terminer</button>
                                        </form>
                                    </t>
                                    <t t-if="q['etat'] == 'faite'">
                                        <form class="inl" method="post" action="/tour/quetes/relancer">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="quete_id" t-att-value="q['id']"/>
                                            <button class="btn off" type="submit">Relancer</button>
                                        </form>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="vide">Aucune quête. Génère une offre pour en créer.</div>
                    </t>
                </div>
        </t>
    </template>
<template id="page_descente" name="La Descente — webapp">
    <html>
      <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>La Descente — Tour de Contrôle</title>
        <style>
          :root{--fond:#020817;--surface:#0f172a;--surface2:#1e293b;--texte:#e2e8f0;--doux:#94a3b8;--primaire:#3b82f6;--r:.6rem}
          *{box-sizing:border-box}
          body{margin:0;background:var(--fond);color:var(--texte);font-family:ui-sans-serif,system-ui,"Segoe UI",sans-serif;line-height:1.6}
          .wrap{max-width:760px;margin:0 auto;padding:1.2rem}
          h1{font-size:1.6rem;margin:.3rem 0}
          .sub{color:var(--doux);margin-bottom:1.2rem}
          .couche{background:var(--surface);border:1px solid var(--surface2);border-left:4px solid var(--primaire);border-radius:var(--r);padding:1rem;margin:.7rem 0}
          .couche .n{font-family:ui-monospace,Menlo,monospace;color:var(--doux);font-size:.8rem}
          .couche b{display:block;font-size:1.05rem}
          .couche p{margin:.2rem 0 0;color:var(--doux);font-size:.92rem}
          .porte{display:inline-block;background:var(--surface2);border-radius:20px;padding:2px 12px;font-size:.85rem;color:var(--doux);margin:.5rem .3rem 0 0}
          h2{font-size:.75rem;letter-spacing:.15em;text-transform:uppercase;color:var(--doux);margin:1.4rem 0 .5rem}
          ul{list-style:none;padding:0}
          li{background:var(--surface);border:1px solid var(--surface2);border-radius:var(--r);padding:.7rem 1rem;margin:.4rem 0;font-size:.92rem}
          li .st{float:right;color:var(--doux);font-size:.75rem}
          a.retour{color:var(--primaire);text-decoration:none;font-size:.85rem}
        </style>
      </head>
      <body>
        <div class="wrap">
          <p><a class="retour" href="/tour/dashboard">← l'accueil</a></p>
          <h1>La Descente</h1>
          <p class="sub">plonger dans la machine couche par couche, jusqu'au traitement des biais.</p>

          <h2>Les couches</h2>
          <t t-foreach="couches" t-as="c">
            <div class="couche">
              <span class="n">Couche <t t-esc="c[0]"/></span>
              <b><t t-esc="c[1]"/></b>
              <p><t t-esc="c[2]"/></p>
            </div>
          </t>

          <h2>La quête — tâches du projet</h2>
          <ul>
            <t t-foreach="taches" t-as="t">
              <li><span class="st"><t t-esc="t['state']"/></span><t t-esc="t['name']"/></li>
            </t>
            <t t-if="not taches"><li>La quête commence — aucune tâche pour l'instant.</li></t>
          </ul>

          <p class="sub" style="margin-top:1.4rem">La limite honnête : le modèle est une
          boîte noire — on mesure les biais en sortie et on les corrige depuis les couches
          qu'on contrôle (consignes, garde-fous, circuits).</p>
        </div>
      </body>
    </html>
  </template>
<template id="page_mon_histoire" name="Mon histoire — quête d'aventuriers">
    <html>
      <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Mon histoire — Tour de Contrôle</title>
        <style>
          :root{--fond:#0b1120;--surface:#0f172a;--surface2:#1e293b;--texte:#e2e8f0;--doux:#94a3b8;--or:#d4af37;--primaire:#3b82f6;--r:.6rem}
          *{box-sizing:border-box}
          body{margin:0;background:var(--fond);color:var(--texte);font-family:ui-sans-serif,system-ui,"Segoe UI",sans-serif;line-height:1.6}
          .wrap{max-width:780px;margin:0 auto;padding:1.2rem}
          h1{font-size:1.7rem;margin:.3rem 0}
          .sous{color:var(--doux);margin-bottom:1.4rem}
          .chap{background:var(--surface);border:1px solid var(--surface2);border-radius:var(--r);padding:1rem;margin:1rem 0}
          .chap h2{margin:0 0 .6rem;font-size:1.05rem;color:var(--or);letter-spacing:.04em}
          .av{background:var(--surface2);border-radius:var(--r);padding:.7rem .9rem;margin:.5rem 0}
          .av b{display:block;font-size:.95rem}
          .av .m{color:var(--doux);font-size:.78rem}
          .av p{color:#cbd5e1;font-size:.88rem;margin:.35rem 0 0}
          .total{color:var(--doux);font-size:.85rem;margin-bottom:1rem}
          a.retour{color:var(--primaire);text-decoration:none;font-size:.85rem}
        </style>
      </head>
      <body>
        <div class="wrap">
          <p><a class="retour" href="/tour/dashboard">← l'accueil</a></p>
          <h1>Mon histoire</h1>
          <p class="sous">la quête d'aventuriers — écrite par le travail réel,
          jour après jour.</p>
          <p class="total"><t t-esc="total"/> aventures consignées.</p>

          <t t-foreach="chapitres" t-as="chap">
            <div class="chap">
              <h2>Chapitre — <t t-esc="chap['cle']"/></h2>
              <t t-foreach="chap['aventures']" t-as="a">
                <div class="av">
                  <b><t t-esc="a['name']"/></b>
                  <span class="m"><t t-esc="a['date']"/><t t-if="a['auteur']"> · <t t-esc="a['auteur']"/></t></span>
                  <p><t t-esc="a['reponse']"/></p>
                </div>
              </t>
            </div>
          </t>
          <t t-if="not chapitres"><p class="sous">La quête commence — rien encore.</p></t>
        </div>
      </body>
    </html>
  </template>

  <template id="page_commande" name="Commande — webapp shell">
    <html>
      <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Commande — Tour de Contrôle</title>
        <style>
          :root{--fond:#020817;--surface:#0f172a;--surface2:#1e293b;--texte:#e2e8f0;--doux:#94a3b8;--primaire:#3b82f6;--r:.6rem;--ok:#22c55e}
          *{box-sizing:border-box}
          body{margin:0;background:var(--fond);color:var(--texte);font-family:ui-monospace,Menlo,monospace;line-height:1.5}
          .wrap{max-width:820px;margin:0 auto;padding:1.2rem}
          h1{font-size:1.3rem}
          .sub{color:var(--doux);font-size:.85rem;margin-bottom:1rem}
          form{display:flex;gap:.5rem}
          input{flex:1;background:var(--surface);border:1px solid var(--surface2);border-radius:.5rem;color:var(--texte);padding:.6rem .8rem;font-family:ui-monospace,monospace;font-size:.95rem}
          button{background:var(--primaire);color:#fff;border:0;border-radius:.5rem;padding:.6rem 1.2rem;cursor:pointer}
          .out{background:#04121a;border:1px solid var(--surface2);border-radius:.5rem;padding:1rem;margin-top:1rem;white-space:pre-wrap;font-size:.88rem;min-height:6rem}
          .ok{color:var(--ok)}
          a.retour{color:var(--primaire);text-decoration:none;font-size:.85rem;font-family:ui-sans-serif,sans-serif}
          .hint{color:var(--doux);font-size:.78rem;margin-top:.8rem}
        </style>
      </head>
      <body>
        <div class="wrap">
          <p><a class="retour" href="/tour/dashboard">← l'accueil</a></p>
          <h1>Commande — la machine à la voix</h1>
          <p class="sub">pilote seulement · exécution confinée (bwrap) · journalisée · pas de réseau</p>
          <form method="post" action="/tour/commande">
            <input name="commande" placeholder="ex. uname -a   |   ps aux   |   df -h"
                   value="" autofocus="autofocus"/>
            <button type="submit">Exécuter</button>
          </form>
          <t t-if="resultat">
            <div class="out"><t t-esc="resultat['stdout']"/><t t-if="resultat['stderr']">
<hr/><t t-esc="resultat['stderr']"/></t><t t-if="not resultat['stdout'] and not resultat['stderr']">(aucune sortie)</t></div>
            <p class="sub">code de sortie : <span class="ok"><t t-esc="resultat['code']"/></span> · <t t-esc="commande"/></p>
          </t>
          <p class="hint">La commande tourne dans un bac à sable : machine en lecture seule, pas de réseau, secrets masqués. Chaque exécution est consignée.</p>
        </div>
      </body>
    </html>
  </template>

  <template id="page_documents" name="Mes documents — coffre privé">
    <html>
      <head>
        <meta charset="utf-8"/>
        <title>Mes documents — Tour de contrôle</title>
        <style>
          body{font-family:ui-monospace,Menlo,Consolas,monospace;background:#0e1117;color:#e6edf3;max-width:640px;margin:2rem auto;padding:0 1rem}
          h1{font-size:1.4rem;border-bottom:1px solid #30363d;padding-bottom:.5rem}
          .fichier{display:flex;justify-content:space-between;align-items:center;padding:.6rem .8rem;border:1px solid #30363d;border-radius:8px;margin:.5rem 0;background:#161b22}
          .fichier .taille{color:#8b949e;font-size:.8rem}
          a{color:#58a6ff;text-decoration:none}
          .deposer{margin-top:1.5rem;padding:1rem;border:1px dashed #30363d;border-radius:8px}
          .deposer input[type=file]{margin-right:.5rem}
          button{background:#238636;color:#fff;border:0;padding:.4rem .8rem;border-radius:6px;cursor:pointer}
          .vide{color:#8b949e}
        </style>
      </head>
      <body>
        <h1>🛡️ Mes documents</h1>
        <p class="sub">Coffre privé du pilote : seuls toi (connecté admin) peux voir, déposer et télécharger. Jamais public.</p>
        <t t-if="not fichiers">
          <p class="vide">(aucun document pour l'instant)</p>
        </t>
        <div t-foreach="fichiers" t-as="f">
          <div class="fichier">
            <a t-att-href="'/tour/documents/%s' % f['nom']"><t t-esc="f['nom']"/></a>
            <span class="taille"><t t-esc="f['octets']"/> octets</span>
          </div>
        </div>
        <form class="deposer" method="post" enctype="multipart/form-data"
              action="/tour/documents/deposer">
          <input type="file" name="fichier"/>
          <button type="submit">Déposer ici</button>
        </form>
        <p><a href="/tour/dashboard">← retour à la Tour</a></p>
      </body>
    </html>
  </template>

</odoo>