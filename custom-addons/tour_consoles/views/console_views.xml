<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tour_console_list" model="ir.ui.view">
        <field name="name">tour.console.list</field>
        <field name="model">tour.console</field>
        <field name="arch" type="xml">
            <list string="Consoles">
                <field name="name"/>
                <field name="a_quoi"/>
                <field name="categorie"/>
                <field name="compte" optional="show"/>
                <field name="secret_id" optional="hide"/>
                <button name="action_ouvrir" type="object" string="Ouvrir"
                        icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="view_tour_console_form" model="ir.ui.view">
        <field name="name">tour.console.form</field>
        <field name="model">tour.console</field>
        <field name="arch" type="xml">
            <form string="Console">
                <header>
                    <button name="action_ouvrir" type="object"
                            string="Ouvrir la console" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du service"/></h1>
                        <field name="a_quoi" placeholder="Ce qu'on vient y faire"/>
                    </div>
                    <group>
                        <group>
                            <field name="url" widget="url"/>
                            <field name="categorie"/>
                        </group>
                        <group>
                            <field name="compte"/>
                            <field name="secret_id"/>
                            <field name="perso"/>
                        </group>
                    </group>
                    <group string="À savoir">
                        <field name="notes" nolabel="1"
                               placeholder="Pièges, délais, particularités du compte."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tour_console_search" model="ir.ui.view">
        <field name="name">tour.console.search</field>
        <field name="model">tour.console</field>
        <field name="arch" type="xml">
            <search string="Chercher une console">
                <field name="name" string="Chercher"
                       filter_domain="['|','|',('name','ilike',self),
                                       ('a_quoi','ilike',self),
                                       ('notes','ilike',self)]"/>
                <group expand="1" string="Regrouper par">
                    <filter name="g_cat" string="Catégorie"
                            context="{'group_by': 'categorie'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Une console marquée personnelle n'est visible que par qui l'a créée. -->
    <record id="rule_tour_console_perso" model="ir.rule">
        <field name="name">Consoles : masquer les fiches personnelles des autres</field>
        <field name="model_id" ref="model_tour_console"/>
        <field name="domain_force">['|', ('perso', '=', False), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="action_tour_console" model="ir.actions.act_window">
        <field name="name">Consoles externes</field>
        <field name="res_model">tour.console</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tour_console_search"/>
        <field name="context">{'search_default_g_cat': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune console enregistrée</p>
            <p>Rangez ici les tableaux de bord que vous utilisez ailleurs :
               hébergeur, paiement, base de données, boutique. Le jour où il faut
               faire une manipulation soi-même, on sait où aller.</p>
        </field>
    </record>

    <menuitem id="menu_consoles_racine" name="Consoles" sequence="88"/>
    <menuitem id="menu_consoles" name="Tableaux de bord externes"
              parent="menu_consoles_racine" action="action_tour_console"/>
</odoo>
