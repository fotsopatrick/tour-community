<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Un secret appartient a une personne. Meme un administrateur du coffre
         ne voit pas ceux des autres : c'est le minimum attendu d'un coffre
         partage entre plusieurs utilisateurs d'une meme tour. -->
    <record id="rule_vault_secret_perso" model="ir.rule">
        <field name="name">Coffre : ses propres secrets uniquement</field>
        <field name="model_id" ref="model_vault_secret"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('tour_vault.group_vault_user'))]"/>
    </record>
</odoo>
