<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vault_secret_list" model="ir.ui.view">
        <field name="name">vault.secret.list</field>
        <field name="model">vault.secret</field>
        <field name="arch" type="xml">
            <!-- Le secret lui-meme n'est JAMAIS dans une liste : seulement
                 le fait qu'il existe. -->
            <list string="Coffre">
                <field name="name"/>
                <field name="categorie"/>
                <field name="identifiant"/>
                <field name="secret_defini" string="Renseigné"/>
                <field name="derniere_lecture" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_vault_secret_form" model="ir.ui.view">
        <field name="name">vault.secret.form</field>
        <field name="model">vault.secret</field>
        <field name="arch" type="xml">
            <form string="Secret">
                <header>
                    <button name="action_reveler" type="object" string="Révéler"
                            class="btn-primary" invisible="not secret_defini"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"
                                   placeholder="Supabase Duelle — mot de passe base"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="categorie"/>
                            <field name="identifiant"/>
                            <field name="url" widget="url"/>
                        </group>
                        <group>
                            <field name="secret" password="True"
                                   placeholder="Coller ici — chiffré à l'enregistrement"/>
                            <field name="secret_defini" invisible="1"/>
                            <field name="protection"/>
                            <field name="derniere_lecture"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_vault_secret" model="ir.actions.act_window">
        <field name="name">Coffre</field>
        <field name="res_model">vault.secret</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ranger un premier secret</p>
            <p>Mots de passe et clés d'API, chiffrés. Plus besoin de les coller
               dans une conversation ou un fichier sur le bureau.</p>
        </field>
    </record>

    <menuitem id="menu_vault_racine" name="Coffre" sequence="86"
              groups="tour_vault.group_vault_user"
              web_icon="tour_vault,static/description/icon.svg"/>
    <menuitem id="menu_vault" name="Mes secrets" parent="menu_vault_racine"
              action="action_vault_secret"/>
</odoo>
