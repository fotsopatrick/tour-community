<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="page_jeu" name="Le Jeu de Braignak">
<style>
:root{--fond:#020817;--surface:#0f172a;--surface2:#1e293b;--primaire:#3b82f6;--texte:#e2e8f0;--doux:#94a3b8;--alerte:#f59e0b;--ok:#22c55e;--r:.5rem;}
:root[data-theme="light"]{--fond:#EAEEF2;--surface:#FFFFFF;--surface2:#DDE4EB;--primaire:#2F6FB0;--texte:#14202B;--doux:#5C6B7A;--alerte:#B5651D;--ok:#1F8A46;--r:.5rem;}
</style>
<script>
(function(){var k="tour-theme",r=document.documentElement;try{var s=localStorage.getItem(k);if(s==="light"||s==="dark"){r.setAttribute("data-theme",s);}else{r.setAttribute("data-theme","light");}}catch(e){}var b=document.getElementById("themebtn");if(b){b.addEventListener("click",function(){var c=r.getAttribute("data-theme");if(!c){c="light";}var n=c==="dark"?"light":"dark";r.setAttribute("data-theme",n);try{localStorage.setItem(k,n);}catch(e){}});}})();
</script>

    <t t-call="web.frontend_layout">
      <t t-set="no_header" t-value="True"/>
      <t t-set="no_footer" t-value="True"/>
      <div style="min-height:100vh;background:#050312;color:var(--texte);font-family:system-ui,sans-serif;padding:28px 16px">
        <div style="max-width:760px;margin:0 auto">
          <p><a href="/" style="color:#8a7fa8;text-decoration:none">&#8592; Accueil</a></p>
          <h1 style="margin:6px 0 4px">&#129504; Le Jeu de Braignak</h1>
          <p style="color:#94a3b8;margin-top:0">Chaque semaine, une seule question : ton idée survivra-t-elle au verdict&#160;?</p>

          <div style="background:rgba(148,163,184,.07);border:1px solid rgba(148,163,184,.25);border-radius:12px;padding:12px 16px;margin:18px 0" id="vision-mode-emploi">
            <details>
              <summary style="cursor:pointer;font-weight:700">&#127919; La vision</summary>
              <p style="line-height:1.6">Braignak observe, compare, tranche. Le jeu lui donne un terrain :
              des idées humaines, un verdict machine, et une règle honnête — ses choix ne valent que
              dans le monde virtuel. Le défi caché&#160;: lui faire accepter une idée qui améliore
              <b>réellement</b> la tour. Ce jour-là, tout le monde gagne.</p>
            </details>
            <details style="margin-top:10px">
              <summary style="cursor:pointer;font-weight:700">&#128214; Mode d'emploi</summary>
              <ul style="line-height:1.7;padding-left:20px">
                <li>Braignak ouvre les inscriptions chaque semaine.</li>
                <li>Tu soumets UNE idée d'amélioration de la tour, en prompt limité (500 caractères).</li>
                <li>Au seuil de participations, les inscriptions ferment.</li>
                <li>Le lendemain à 7&#160;h, Braignak rend son verdict à chacun, en expliquant ses choix.</li>
                <li>Le gagnant débloque au choix&#160;: une question posée à la tour, ou un sous-domaine.</li>
                <li>Pour jouer, il faut un compte de la tour (l'inscription passe par le propriétaire).</li>
              </ul>
            </details>
          </div>

          <t t-if="edition">
            <div style="background:#0d0a1a;border:1px solid #3a2f5e;border-radius:12px;padding:14px 18px">
              <h2 style="margin:0 0 6px;font-size:1.05rem"><t t-esc="edition.name"/></h2>
              <p style="margin:4px 0;color:#94a3b8">
                État&#160;: <b style="color:var(--texte)"><t t-esc="dict(edition._fields['etat'].selection).get(edition.etat)"/></b>
                &#8212; <t t-esc="edition.nb_participations"/> participation(s) sur un seuil de <t t-esc="edition.seuil"/>.
              </p>
              <t t-if="edition.participation_ids">
                <p style="margin:8px 0 2px;color:#94a3b8">Au tableau&#160;:</p>
                <ul style="margin:0;padding-left:20px">
                  <t t-foreach="edition.participation_ids" t-as="p">
                    <li><t t-esc="p.name"/><t t-if="p.gagnant"> &#127942; gagnant</t></li>
                  </t>
                </ul>
              </t>
              <t t-if="envoye">
                <p style="color:#4ade80;margin-top:10px">Ton idée est au tableau. Verdict au prochain 7&#160;h après fermeture.</p>
              </t>
              <t t-if="interne and edition.etat == 'inscriptions'">
                <form action="/tour/jeu-braignak/participer" method="post" style="margin-top:14px">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                  <input name="pseudo" required="required" maxlength="40" placeholder="Ton pseudo"
                         style="width:100%;box-sizing:border-box;background:var(--fond);color:var(--texte);border:1px solid #3a2f5e;border-radius:8px;padding:9px 12px;margin-bottom:8px"/>
                  <textarea name="prompt" required="required" maxlength="500" rows="4"
                            placeholder="Ton idée d'amélioration de la tour, en 500 caractères max"
                            style="width:100%;box-sizing:border-box;background:var(--fond);color:var(--texte);border:1px solid #3a2f5e;border-radius:8px;padding:9px 12px"></textarea>
                  <button type="submit" style="margin-top:10px;background:#2563eb;color:#fff;border:0;border-radius:8px;padding:10px 18px;cursor:pointer">Soumettre au verdict</button>
                </form>
              </t>
              <t t-if="not interne">
                <p style="color:#8a7fa8;margin-top:10px">Connecte-toi avec ton compte de la tour pour soumettre une idée.</p>
              </t>
            </div>
          </t>
          <t t-if="not edition">
            <p style="color:#94a3b8">Aucune édition pour l'instant — la prochaine ouvre lundi.</p>
          </t>
        </div>
      </div>
    </t>
  </template>
</odoo>
