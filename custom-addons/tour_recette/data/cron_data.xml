<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Une fois par jour, tôt. Assez souvent pour attraper une casse
             avant le client, assez rare pour ne jamais peser sur un site. -->
        <record id="cron_recette" model="ir.cron">
            <field name="name">Vibe : dérouler les cahiers de recette</field>
            <field name="model_id" ref="model_recette_cible"/>
            <field name="state">code</field>
            <field name="code">model._cron_passer()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
