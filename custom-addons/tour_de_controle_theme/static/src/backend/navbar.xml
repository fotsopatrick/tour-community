<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//nav[hasclass('o_main_navbar')]" position="inside">
            <!-- Le logo est un LIEN vers la liste des applications. Il ne l'etait pas :
                 c'est le premier reflexe de tout le monde sur un site comme dans un
                 logiciel, et un logo qui ne repond pas au clic donne l'impression
                 d'une page figee. -->
            <a class="tdc_brand" role="banner" href="/odoo" title="Toutes mes applications">
                <span class="tdc_brand_logo">
                    <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                        <rect width="64" height="64" rx="14" fill="#1e293b"/>
                        <line x1="32" y1="10" x2="32" y2="18" stroke="#3b82f6" stroke-width="3" stroke-linecap="round"/>
                        <circle cx="32" cy="9" r="3" fill="#3b82f6"/>
                        <path d="M17 20 h30 l-5 12 h-20 z" fill="#3b82f6"/>
                        <path d="M27 32 h10 l3 22 h-16 z" fill="#cbd5e1"/>
                        <line x1="22" y1="54" x2="42" y2="54" stroke="#cbd5e1" stroke-width="3" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="tdc_brand_name">Tour de contrôle</span>
            </a>
        </xpath>
    </t>

</templates>
