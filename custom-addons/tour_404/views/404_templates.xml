<script>
      // Badge Twitch « EN DIRECT » (08/08) : la vitrine est statique, elle
      // interroge la tour (/twitch-live, même origine) pour savoir si Patrick
      // diffuse. En cas d'échec : pas de badge, pas d'erreur visible.
      (function () {
        var el = document.getElementById("twitch-live");
        if (!el) return;
        fetch("/twitch-live", {cache: "no-store"})
          .then(function (r) { return r.json(); })
          .then(function (d) { if (d &amp;&amp; d.live) { el.style.display = "inline"; } })
          .catch(function () {});
      })();
    </script>
