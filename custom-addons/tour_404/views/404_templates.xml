<script>
      // Compteur de visites (01/08) : pixel 1x1, id anonyme local.
      (function () {
        var cle = "tdc_v"; var uid = "";
        try { uid = localStorage.getItem(cle) || ""; } catch (e) {}
        if (!uid) {
          uid = "v" + Math.random().toString(36).slice(2, 12) + Date.now().toString(36);
          try { localStorage.setItem(cle, uid); } catch (e) {}
        }
        new Image().src = "/pix?u=" + encodeURIComponent(uid)
          + "&amp;p=" + encodeURIComponent(location.pathname);
      })();
    </script>
