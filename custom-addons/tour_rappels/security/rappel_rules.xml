<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Chacun ne voit et ne gère que ses propres rappels ; les
         administrateurs voient tout (support, mise en place chez un client). -->
    <record id="rule_tour_rappel_perso" model="ir.rule">
        <field name="name">Rappels : les siens uniquement</field>
        <field name="model_id" ref="model_tour_rappel"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_tour_rappel_admin" model="ir.rule">
        <field name="name">Rappels : tous pour les administrateurs</field>
        <field name="model_id" ref="model_tour_rappel"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
