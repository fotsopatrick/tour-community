<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- L'admin (base.group_system) voit tout. La regle est GLOBALE :
             quand un utilisateur a une regle globale sur un modele, les
             regles non globales sont ignorees pour lui. C'est ce qui leve
             le piege « chacun ses etudes + admin voit tout = l'admin est
             restreint » (paye le 06/08/2026). -->
        <record id="braignak_etude_admin_rule" model="ir.rule">
            <field name="name">braignak.etude : l'administrateur voit tout</field>
            <field name="model_id" ref="model_braignak_etude"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="global" eval="True"/>
        </record>
        <!-- Les autres utilisateurs ne voient que leurs etudes. -->
        <record id="braignak_etude_user_rule" model="ir.rule">
            <field name="name">braignak.etude : chacun ses etudes</field>
            <field name="model_id" ref="model_braignak_etude"/>
            <field name="domain_force">[('demandeur_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
