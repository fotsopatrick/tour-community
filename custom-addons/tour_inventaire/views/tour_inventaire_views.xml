<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tour_module_view_list" model="ir.ui.view">
        <field name="name">tour.module.list</field>
        <field name="model">tour.module</field>
        <field name="arch" type="xml">
            <list string="Inventaire des modules" default_order="name">
                <field name="name"/>
                <field name="nom_affichage"/>
                <field name="installe" widget="boolean_toggle"/>
                <field name="version"/>
                <field name="statut"/>
                <field name="agent_id"/>
            </list>
        </field>
    </record>

    <record id="tour_module_view_search" model="ir.ui.view">
        <field name="name">tour.module.search</field>
        <field name="model">tour.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="nom_affichage"/>
                <filter name="f_installes" string="Installés"
                        domain="[('installe','=',True)]"/>
                <filter name="f_non_installes" string="Non installés"
                        domain="[('installe','=',False)]"/>
                <filter name="f_chantier" string="En chantier"
                        domain="[('statut','in',('a_faire','partiel'))]"/>
            </search>
        </field>
    </record>

    <record id="tour_module_view_form" model="ir.ui.view">
        <field name="name">tour.module.form</field>
        <field name="model">tour.module</field>
        <field name="arch" type="xml">
            <form string="Module">
                <header>
                    <button name="action_synchroniser" type="object"
                            string="Recaler sur la réalité"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="nom_affichage" readonly="1"/></h1>
                        <h3><field name="name" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="installe" readonly="1"/>
                            <field name="version" readonly="1"/>
                        </group>
                        <group>
                            <field name="statut"/>
                            <field name="agent_id"/>
                        </group>
                    </group>
                    <group string="Ce qu'il fait">
                        <field name="description" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tour_module_action" model="ir.actions.act_window">
        <field name="name">Modules</field>
        <field name="res_model">tour.module</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Inventaire vide.</p>
            <p>La liste de tout ce qui compose la tour. Elle se recale toute
               seule sur la réalité chaque nuit — bouton « Recaler sur la
               réalité » pour le faire maintenant.</p>
        </field>
    </record>

    <menuitem id="menu_inventaire_racine" name="Modules" sequence="99"
              web_icon="tour_inventaire,static/description/icon.svg"
              groups="base.group_system"
              action="tour_module_action"/>

    <record id="cron_inventaire" model="ir.cron">
        <field name="name">Inventaire : recaler les modules</field>
        <field name="model_id" ref="model_tour_module"/>
        <field name="state">code</field>
        <field name="code">model._cron_synchroniser()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
