<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Une fois par jour. Le cron existe partout, l'envoi ne part que
             si tour_nouveautes.annonces_actives est posé sur la base. -->
        <record id="cron_annoncer" model="ir.cron">
            <field name="name">Nouveautés : prévenir les utilisateurs</field>
            <field name="model_id" ref="model_tour_nouveaute"/>
            <field name="state">code</field>
            <field name="code">model._cron_annoncer()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
