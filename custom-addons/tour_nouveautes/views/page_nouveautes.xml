<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_nouveautes" name="Quoi de neuf">
        <t t-call="web.layout">
            <t t-set="head">
                <style>
                    body { background:#020817; color:#e2e8f0;
                           font-family:system-ui, sans-serif; margin:0; }
                    .cadre { max-width:820px; margin:0 auto; padding:32px 20px; }
                    h1 { color:#f8fafc; font-size:1.6rem; }
                    h2 { color:#93c5fd; font-size:1.05rem; margin-top:34px;
                         text-transform:uppercase; letter-spacing:.06em; }
                    .carte { background:#0f172a; border:1px solid #1e293b;
                             border-radius:.5rem; padding:16px 18px;
                             margin-bottom:12px; }
                    .carte .quand { color:#64748b; font-size:.85rem; }
                    .carte h3 { margin:.2rem 0 .4rem; color:#f8fafc;
                                font-size:1.05rem; }
                    .carte p { margin:0; line-height:1.55; white-space:pre-line; }
                    .carte a { color:#3b82f6; text-decoration:none; }
                    .retour { display:inline-block; margin-bottom:18px;
                              color:#3b82f6; text-decoration:none; }
                    .neuf { border-color:#3b82f6; }
                </style>
            </t>
            <div class="cadre">
                <a class="retour" href="/community">← Retour à l'accueil</a>
                <h1>Quoi de neuf dans la tour</h1>
                <p style="color:#94a3b8">Chaque nouveauté, expliquée simplement.
                Les plus fraîches d'abord.</p>

                <h2>Ces 30 derniers jours</h2>
                <t t-if="not recentes">
                    <p style="color:#64748b">Rien de neuf ce mois-ci.</p>
                </t>
                <t t-foreach="recentes" t-as="n">
                    <div class="carte neuf">
                        <div class="quand"><t t-esc="n.date"/></div>
                        <h3><t t-esc="n.name"/></h3>
                        <p><t t-esc="n.explication"/></p>
                        <p t-if="n.lien"><a t-att-href="n.lien">Où cliquer →</a></p>
                    </div>
                </t>

                <h2>Toutes les fonctionnalités</h2>
                <t t-foreach="toutes" t-as="n">
                    <div class="carte">
                        <div class="quand"><t t-esc="n.date"/></div>
                        <h3><t t-esc="n.name"/></h3>
                        <p><t t-esc="n.explication"/></p>
                        <p t-if="n.lien"><a t-att-href="n.lien">Où cliquer →</a></p>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
