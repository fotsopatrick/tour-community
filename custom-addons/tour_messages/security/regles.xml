<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Chacun sa bibliothèque, l'admin tout.

        DEUX règles de GROUPE, jamais une seule règle globale : une règle
        sans `groups` s'applique à TOUT LE MONDE, administrateur compris, et
        enferme alors tout le monde dehors. C'est la leçon de Clark sur
        tour_reponses, déjà payée une fois — elle est écrite en toutes
        lettres dans tour_atelier/security/regles.xml.

        Deux règles de groupe se combinent en OU : l'admin passe par la
        sienne quoi qu'il arrive.
    -->
    <record id="regle_message_proprietaire" model="ir.rule">
        <field name="name">Messages : chacun les siens</field>
        <field name="model_id" ref="model_tour_message"/>
        <field name="domain_force">[("user_id", "=", user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="regle_message_admin" model="ir.rule">
        <field name="name">Messages : l'admin voit tout</field>
        <field name="model_id" ref="model_tour_message"/>
        <field name="domain_force">[(1, "=", 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
