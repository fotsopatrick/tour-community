<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_messages" name="Bibliothèque de messages">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'lang': 'fr-FR'}"/>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Messages</title>
                <style>
                    body { background:#020817; color:#e2e8f0; margin:0;
                           font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
                    .ms-wrap { max-width:820px; margin:0 auto; padding:24px 16px 64px; }
                    a.ms-retour { color:#3b82f6; text-decoration:none; font-size:.88rem; }
                    h1 { font-size:1.7rem; margin:14px 0 4px; }
                    .ms-sous { color:#94a3b8; margin:0 0 22px; line-height:1.5; font-size:.92rem; }
                    .ms-cat { color:#64748b; font-size:.78rem; text-transform:uppercase;
                              letter-spacing:.08em; margin:26px 0 10px; font-weight:600; }
                    .ms-carte { background:#0f172a; border:1px solid #1e293b;
                                border-radius:.6rem; padding:16px; margin-bottom:12px; }
                    .ms-haut { display:flex; align-items:center; gap:10px; margin-bottom:10px; }
                    .ms-titre { font-weight:600; flex:1 1 auto; min-width:0; }
                    .ms-pour { color:#64748b; font-size:.78rem; }
                    .ms-corps { white-space:pre-wrap; color:#cbd5e1; font-size:.92rem;
                                line-height:1.55; background:#020817; border:1px solid #1e293b;
                                border-radius:.45rem; padding:12px; margin:0; }
                    .ms-copier { flex:0 0 auto; background:#3b82f6; color:#fff; border:0;
                                 border-radius:.45rem; padding:8px 14px; font-size:.85rem;
                                 font-weight:600; cursor:pointer; }
                    .ms-copier.ok { background:#16a34a; }
                    .ms-note { color:#64748b; font-size:.78rem; margin-top:8px; font-style:italic; }
                    .ms-vide { color:#64748b; text-align:center; padding:50px 0; }
                    .ms-traite { flex:0 0 auto; background:transparent; color:#64748b;
                                 border:1px solid #1e293b; border-radius:.45rem;
                                 padding:8px 12px; font-size:.85rem; font-weight:600;
                                 cursor:pointer; margin-left:6px; }
                    .ms-traite:hover { color:#22c55e; border-color:#22c55e; }
                    .ms-arch { color:#64748b; text-decoration:none; font-size:.82rem; }
                    .ms-filtres { display:flex; flex-wrap:wrap; gap:8px; margin:6px 0 18px; }
                    .ms-filtre { background:#0f172a; color:#94a3b8; border:1px solid #1e293b;
                                 border-radius:99px; padding:6px 14px; font-size:.82rem;
                                 text-decoration:none; font-weight:600; }
                    .ms-filtre:hover { color:#e2e8f0; border-color:#334155; }
                    .ms-filtre.actif { background:#3b82f6; color:#fff; border-color:#3b82f6; }
                    .ms-nb { display:inline-block; margin-left:6px; background:#1e293b;
                             color:#94a3b8; border-radius:99px; padding:1px 7px;
                             font-size:.72rem; font-weight:700; }
                    .ms-filtre.actif .ms-nb { background:rgba(255,255,255,.22); color:#fff; }
                    .ms-recherche { display:flex; gap:8px; align-items:center;
                                    margin:0 0 20px; flex-wrap:wrap; }
                    .ms-recherche input[type=search] { flex:1 1 240px; background:#0f172a;
                             border:1px solid #1e293b; border-radius:.45rem; color:#e2e8f0;
                             padding:9px 12px; font-size:.88rem; }
                    .ms-recherche button { background:#1e293b; color:#e2e8f0; border:0;
                             border-radius:.45rem; padding:9px 16px; font-size:.85rem;
                             font-weight:600; cursor:pointer; }
                    .ms-effacer { color:#64748b; font-size:.8rem; text-decoration:none; }
                </style>
            </t>
            <div class="ms-wrap">
                <a class="ms-retour" href="/community">← Accueil</a>
                <a class="ms-arch" href="/tour/messages/archives"
                   style="float:right">Archives →</a>
                <h1>Messages</h1>
                <p class="ms-sous">
                    Les textes qu'on réécrit sans cesse, gardés une fois. Touche
                    <b>Copier</b>, adapte le prénom, envoie où tu veux. La tour
                    n'envoie rien à ta place — elle garde, tu décides.
                    Derniers ajoutés en premier. Le nombre à côté de chaque catégorie dit combien il y en a.
                </p>

                <div class="ms-filtres">
                    <a href="/tour/messages"
                       t-att-class="'ms-filtre' + (' actif' if not categorie else '')">Toutes
                       <span class="ms-nb"><t t-esc="tout"/></span></a>
                    <t t-foreach="filtres" t-as="f">
                        <a t-attf-href="/tour/messages?categorie=#{f[0]}"
                           t-att-class="'ms-filtre' + (' actif' if f[2] else '')">
                            <t t-esc="f[1]"/>
                            <span class="ms-nb"><t t-esc="f[3]"/></span>
                        </a>
                    </t>
                </div>

                <form class="ms-recherche" method="get" action="/tour/messages">
                    <input type="hidden" name="categorie" t-att-value="categorie"/>
                    <input type="search" name="q" t-att-value="cherche"
                           placeholder="Chercher dans les titres et les textes…"/>
                    <button type="submit">Chercher</button>
                    <a t-if="cherche" t-attf-href="/tour/messages?categorie=#{categorie}"
                       class="ms-effacer">effacer</a>
                </form>
                <p t-if="cherche" class="ms-sous" style="margin:0 0 14px">
                    <t t-esc="total"/> message(s) contiennent « <t t-esc="cherche"/> ».
                </p>

                <t t-if="not total">
                    <div class="ms-vide">Aucun message pour l'instant. Ajoute-en
                    depuis « Gérer les messages ».</div>
                </t>

                <t t-foreach="groupes" t-as="grp">
                    <div class="ms-cat"><t t-esc="grp[0]"/></div>
                    <t t-foreach="grp[1]" t-as="m">
                        <div class="ms-carte">
                            <div class="ms-haut">
                                <div class="ms-titre">
                                    <t t-esc="m.name"/>
                                    <t t-if="m.pour_qui">
                                        <span class="ms-pour"> — <t t-esc="m.pour_qui"/></span>
                                    </t>
                                </div>
                                <button type="button" class="ms-copier"
                                        t-att-data-corps-html="m.corps">Copier</button>
                                <form method="post" t-attf-action="/tour/messages/#{m.id}/traite"
                                      style="display:inline;margin:0">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="ms-traite"
                                            title="Il a servi : le ranger dans les archives">Traité</button>
                                </form>
                            </div>
                            <div class="ms-corps" t-out="m.corps"/>
                            <div class="ms-note" t-if="m.remarque">
                                <t t-esc="m.remarque"/>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
            <script type="text/javascript">
                // Copie dans le presse-papier. navigator.clipboard exige https —
                // la tour l'est. Repli sur l'ancienne methode si indisponible
                // (certains navigateurs mobiles anciens), pour ne jamais laisser
                // un bouton qui ne fait rien sans le dire.
                document.querySelectorAll('.ms-copier').forEach(function (b) {
                    b.addEventListener('click', function () {
                        // Le texte copié doit être PROPRE (sans balises HTML) :
                        // il part sur Discord / LinkedIn / un mail.
                        var html = b.getAttribute('data-corps-html') || '';
                        var tmp = document.createElement('div');
                        tmp.innerHTML = html;
                        var txt = (tmp.textContent || tmp.innerText || '').replace(/\s+\n\s+/g, '\n').trim();
                        var fini = function () {
                            var av = b.textContent;
                            b.textContent = 'Copié ✓';
                            b.classList.add('ok');
                            setTimeout(function () {
                                b.textContent = av; b.classList.remove('ok');
                            }, 1500);
                        };
                        if (navigator.clipboard &amp;&amp; navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(txt).then(fini, function () {});
                        } else {
                            var t = document.createElement('textarea');
                            t.value = txt; document.body.appendChild(t); t.select();
                            try { document.execCommand('copy'); fini(); } catch (e) {}
                            document.body.removeChild(t);
                        }
                    });
                });
            </script>
        </t>
    </template>


    <template id="page_archives" name="Messages archivés">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'lang': 'fr-FR'}"/>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Archives</title>
                <style>
                    body { background:#020817; color:#e2e8f0; margin:0;
                           font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
                    .ms-wrap { max-width:820px; margin:0 auto; padding:24px 16px 64px; }
                    a.ms-retour { color:#3b82f6; text-decoration:none; font-size:.88rem; }
                    h1 { font-size:1.6rem; margin:14px 0 6px; }
                    .ms-sous { color:#94a3b8; margin:0 0 22px; font-size:.9rem; line-height:1.5; }
                    .ms-carte { background:#0f172a; border:1px solid #1e293b;
                                border-radius:.6rem; padding:14px 16px; margin-bottom:10px; }
                    .ms-titre { font-weight:600; }
                    .ms-quand { color:#64748b; font-size:.78rem; margin-top:3px; }
                    .ms-corps { white-space:pre-wrap; color:#94a3b8; font-size:.88rem;
                                line-height:1.5; margin:10px 0 0; }
                    .ms-vide { color:#64748b; text-align:center; padding:50px 0; }
                </style>
            </t>
            <div class="ms-wrap">
                <a class="ms-retour" href="/tour/messages">← Les messages</a>
                <h1>Archives</h1>
                <p class="ms-sous">Les messages déjà traités. Ils sont rangés,
                pas supprimés : un message envoyé une fois resservira.</p>
                <t t-if="msgs">
                    <t t-foreach="msgs" t-as="m">
                        <div class="ms-carte">
                            <div class="ms-titre"><t t-esc="m.name"/></div>
                            <div class="ms-quand">Traité le
                                <t t-esc="m.traite_le" t-options="{'widget': 'datetime'}"/></div>
                            <div class="ms-corps" t-out="m.corps"/>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div class="ms-vide">Aucun message archivé.</div>
                </t>
            </div>
        </t>
    </template>

</odoo>
