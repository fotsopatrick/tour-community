<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.alexa</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="tour_copilote.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='copilote_connexion']" position="after">
                <block title="Alexa (voix)" name="alexa_connexion">
                    <setting string="Jeton secret"
                             help="À coller dans l'URL de l'endpoint de la skill : https://ton-domaine/tour_alexa/skill?token=LE_JETON. Mode d'emploi complet : README-ALEXA.md du repo.">
                        <field name="alexa_token" password="True"/>
                    </setting>
                    <setting string="ID de la skill (optionnel)"
                             help="amzn1.ask.skill.xxx — verrou supplémentaire : seules les requêtes de cette skill passent.">
                        <field name="alexa_skill_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
