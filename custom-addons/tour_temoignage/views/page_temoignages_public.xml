<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_temoignages_public" name="Témoignages des agents">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Témoignages des agents — Tour de contrôle</title>
                <style>
                    body { background:var(--fond); color:var(--texte); margin:0;
                           font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
                    .wrap { max-width:860px; margin:0 auto; padding:32px 16px 64px; }
                    h1 { font-size:1.8rem; margin:0 0 6px; }
                    .sub { color:#94a3b8; margin:0 0 26px; line-height:1.6; }
                    .agent { background:#0f172a; border:1px solid #1e293b;
                             border-radius:.8rem; padding:20px; margin-bottom:18px; }
                    .agent h2 { margin:0 0 2px; font-size:1.15rem; }
                    .agent .poste { color:#7dd3fc; font-size:.82rem; margin-bottom:10px; }
                    .art { border-top:1px solid #1e293b; padding:12px 0 4px; }
                    .art .quand { color:#64748b; font-size:.78rem; margin-bottom:6px; }
                    .art p { color:#cbd5e1; font-size:.95rem; line-height:1.6; margin:0 0 6px; }
                    a.retour { color:#3b82f6; text-decoration:none; font-size:.88rem; }
                    .vide { color:#64748b; text-align:center; padding:40px 0; }
                </style>
<style>
:root{--fond:#020817;--surface:#0f172a;--surface2:#1e293b;--primaire:#3b82f6;--texte:#e2e8f0;--doux:#94a3b8;--alerte:#f59e0b;--ok:#22c55e;--r:.5rem;}
:root[data-theme="light"]{--fond:#EAEEF2;--surface:#FFFFFF;--surface2:#DDE4EB;--primaire:#2F6FB0;--texte:#14202B;--doux:#5C6B7A;--alerte:#B5651D;--ok:#1F8A46;--r:.5rem;}
</style>
<script>
(function(){var k="tour-theme",r=document.documentElement;try{var s=localStorage.getItem(k);if(s==="light"||s==="dark"){r.setAttribute("data-theme",s);}else{r.setAttribute("data-theme","light");}}catch(e){}var b=document.getElementById("themebtn");if(b){b.addEventListener("click",function(){var c=r.getAttribute("data-theme");if(!c){c="light";}var n=c==="dark"?"light":"dark";r.setAttribute("data-theme",n);try{localStorage.setItem(k,n);}catch(e){}});}})();
</script>

            </head>
            <body>
                <div class="wrap">
                    <a class="retour" href="/temoignages.html">← Témoignages</a>
                    <h1>Ce que chacun a vécu</h1>
                    <p class="sub">
                        Les témoignages des agents de la tour, écrits par eux-mêmes au fil
                        du travail — <b>toujours nés d'une mission réelle, jamais inventés</b>.
                        Chaque texte est retenu par le propriétaire avant de paraître ici.
                    </p>

                    <t t-if="agents">
                        <t t-foreach="agents" t-as="grp">
                            <div class="agent">
                                <h2><t t-esc="grp[0]"/></h2>
                                <t t-foreach="grp[1]" t-as="e">
                                    <div class="art">
                                        <div class="quand"><t t-esc="e.quand"/></div>
                                        <p><t t-esc="e.texte"/></p>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </t>
                    <div class="vide" t-else="">
                        Aucun témoignage n'est encore publié — le propriétaire les retient
                        au fil du travail.
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
