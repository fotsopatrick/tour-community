<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Une boîte mail appartient à une personne. Aucune règle administrateur
         ici, volontairement : personne ne lit la messagerie d'un autre, pas
         même le propriétaire de la tour. -->
    <record id="rule_dev_boite_perso" model="ir.rule">
        <field name="name">Boîtes : la sienne uniquement</field>
        <field name="model_id" ref="model_dev_boite"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_dev_ticket_perso" model="ir.rule">
        <field name="name">Tickets : les siens uniquement</field>
        <field name="model_id" ref="model_dev_ticket"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Même principe pour la connexion Jira : elle porte les identifiants
         d'une personne. Y accéder, c'est agir en son nom dans Jira. -->
    <record id="rule_dev_jira_perso" model="ir.rule">
        <field name="name">Jira : sa connexion uniquement</field>
        <field name="model_id" ref="model_dev_jira"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
