<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_discussion_fil_form" model="ir.ui.view">
        <field name="name">discussion.fil.form</field>
        <field name="model">discussion.fil</field>
        <field name="arch" type="xml">
            <form string="Conversation">
                <header>
                    <button name="action_relever" type="object" string="Actualiser"
                            class="btn-primary" invisible="not en_attente"
                            help="La réponse arrive dans la minute. Ce bouton va la chercher tout de suite."/>
                    <button name="action_recharger_memoire" type="object"
                            string="Recharger ma mémoire"
                            invisible="en_attente"
                            help="Demande à l'agent de relire le vrai SESSION.md de la tour (mémoire) avant de continuer. Fonctionne le mieux avec Autonomie totale cochée."/>
                    <button name="action_oublier" type="object" string="Repartir de zéro"
                            confirm="L'agent oubliera tout ce qui précède. L'historique affiché, lui, est conservé. Continuer ?"
                            invisible="nb_echanges == 0"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="De quoi on parle ?"/></h1>
                    </div>
                    <group>
                        <field name="nb_echanges" invisible="1"/>
                        <field name="en_attente" invisible="1"/>
                        <field name="autonomie"/>
                    </group>

                    <field name="conversation" readonly="1" nolabel="1"/>

                    <group string="Votre message">
                        <field name="question" nolabel="1" colspan="2"
                               placeholder="Écrivez ici. Le fil se souvient de tout ce qui précède."
                               readonly="en_attente"/>
                    </group>
                    <div class="oe_button_box" invisible="en_attente">
                        <button name="action_envoyer" type="object" string="Envoyer"
                                class="btn-primary"/>
                    </div>
                    <div invisible="not en_attente" class="text-muted">
                        <i>Une réponse est en route. Elle arrive dans la minute —
                        le bouton « Actualiser » en haut la cherche tout de suite.</i>
                    </div>
                    <!-- LE PROGRAMME (31/07) : pendant la minute d'attente, on
                         montre à l'utilisateur ce qui se passe, étape par étape.
                         Le JS (static/src/programme.js) anime les étapes et
                         actualise tout seul. L'utilisateur ne peut toujours pas
                         écrire : le champ question est en lecture seule tant que
                         en_attente est vrai. -->
                    <div invisible="not en_attente" class="text-muted"
                         id="tour-programme">
                        <div style="margin-top:10px;font-size:.85rem">
                            Ce qui se passe maintenant :
                            <div style="margin-top:6px;display:flex;flex-direction:column;gap:4px"
                                 id="tour-etapes">
                                <span class="tp" data-tp="0">① Mission déposée dans l'atelier</span>
                                <span class="tp" data-tp="1">② L'atelier la ramasse (cron, ~1 min)</span>
                                <span class="tp" data-tp="2">③ L'agent lit et réfléchit</span>
                                <span class="tp" data-tp="3">④ Le compte rendu revient ici</span>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_discussion_fil_list" model="ir.ui.view">
        <field name="name">discussion.fil.list</field>
        <field name="model">discussion.fil</field>
        <field name="arch" type="xml">
            <list string="Conversations">
                <field name="name"/>
                <field name="nb_echanges"/>
                <field name="en_attente" widget="boolean_toggle" readonly="1"/>
                <field name="write_date" string="Dernier message"/>
            </list>
        </field>
    </record>

    <!--
        Le téléphone est le premier usage de cette fonction, pas le second : on
        discute depuis son canapé, pas devant un tableau. Sans vue kanban, Odoo
        sert une liste sur petit écran — dense, et le bouton de création s'y
        trouve mal. Le kanban devient la vue par défaut ; la liste reste pour
        l'ordinateur.
    -->
    <record id="view_discussion_fil_kanban" model="ir.ui.view">
        <field name="name">discussion.fil.kanban</field>
        <field name="model">discussion.fil</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="en_attente"/>
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-12">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="col-12 text-muted">
                                <field name="nb_echanges"/> échange(s) —
                                <field name="write_date" widget="date"/>
                                <span t-if="record.en_attente.raw_value"
                                      class="badge text-bg-warning">réponse en cours</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_discussion_fil" model="ir.actions.act_window">
        <field name="name">Parler à Clark</field>
        <field name="res_model">discussion.fil</field>
        <!--
            Kanban d'abord : sur téléphone, c'est la vue lisible. La liste reste
            juste derrière pour l'ordinateur.
        -->
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Commencer une conversation</p>
            <p>
                Clark est celui qui écrit le code. Il travaille dans un clone du
                dépôt de la tour — pas dans la production. Il se souvient de ce
                qui a été dit : inutile de répéter le contexte à chaque message.
            </p>
            <p>
                À ne pas confondre avec Chloe, la bulle en bas à droite : elle
                voit la tour (projets, notes, suivi), lui voit le code. Chloe
                peut d'ailleurs lui confier un travail toute seule.
            </p>
        </field>
    </record>

    <menuitem id="menu_discussion_root" name="Clark"
              web_icon="tour_discussion,static/description/icon.svg"
              groups="base.group_system" sequence="46"/>
    <menuitem id="menu_discussion_fils" name="Mes conversations"
              parent="menu_discussion_root" action="action_discussion_fil"
              sequence="10"/>

</odoo>
