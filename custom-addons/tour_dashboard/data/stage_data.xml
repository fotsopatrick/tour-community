<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Le journal n'avait aucune étape : rien ne distinguait « fait » de
             « à faire ». Quatre suffisent, et « Bloqué chez moi » est celle qui
             manquait le plus — elle dit à Patrick ce qu'il retient. -->
        <record id="stage_a_faire" model="project.task.type">
            <field name="name">À faire</field>
            <field name="sequence">10</field>
        </record>
        <record id="stage_en_cours" model="project.task.type">
            <field name="name">En cours</field>
            <field name="sequence">20</field>
        </record>
        <record id="stage_bloque" model="project.task.type">
            <field name="name">Bloqué chez moi</field>
            <field name="sequence">30</field>
        </record>
        <record id="stage_fait" model="project.task.type">
            <field name="name">Fait</field>
            <field name="sequence">40</field>
            <field name="fold" eval="True"/>
        </record>
    </data>
</odoo>
