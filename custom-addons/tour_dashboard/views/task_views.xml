<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_qui" model="ir.ui.view">
        <field name="name">project.task.form.qui</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="after">
                <field name="qui" widget="radio" options="{'horizontal': True}"/>
            </field>
        </field>
    </record>

    <record id="view_task_list_qui" model="ir.ui.view">
        <field name="name">project.task.list.qui</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <field name="stage_id" position="before">
                <field name="qui" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_task_search_qui" model="ir.ui.view">
        <field name="name">project.task.search.qui</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <filter name="my_tasks" position="after">
                <separator/>
                <filter name="qui_proprietaire" string="Ça m'attend"
                        domain="[('qui', '=', 'proprietaire')]"/>
                <filter name="qui_claude" string="Claude s'en charge"
                        domain="[('qui', '=', 'claude')]"/>
                <separator/>
                <filter name="groupby_qui" string="Qui fait"
                        context="{'group_by': 'qui'}"/>
            </filter>
        </field>
    </record>
</odoo>
