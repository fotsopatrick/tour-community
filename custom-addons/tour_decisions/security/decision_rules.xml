<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Chacun ne decide que ce qui lui appartient ; l'admin voit tout.
             Deux regles de GROUPE (jamais une globale) : elles se combinent
             en OU, donc l'admin passe par la seconde — la lecon de Clark
             dans tour_reponses, reprise telle quelle. -->
        <record id="rule_decision_proprietaire" model="ir.rule">
            <field name="name">Chacun ne voit que ses décisions</field>
            <field name="model_id" ref="model_decision_fiche"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_decision_admin" model="ir.rule">
            <field name="name">L'administrateur voit toutes les décisions</field>
            <field name="model_id" ref="model_decision_fiche"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
