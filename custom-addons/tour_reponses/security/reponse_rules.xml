<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Deux regles de GROUPE, et surtout pas une regle globale : les regles
            d'un meme modele attachees a des groupes se combinent en OU. Un
            administrateur appartient aux deux groupes, il tombe donc sous la
            seconde et voit tout. Une regle globale, elle, s'appliquerait aussi
            a lui et l'enfermerait dans ses propres fiches — c'est l'erreur
            qu'on ne voit qu'au moment ou il faut depanner quelqu'un.
        -->
        <record id="rule_reponse_fiche_proprietaire" model="ir.rule">
            <field name="name">Chacun ne voit que ses propres réponses</field>
            <field name="model_id" ref="model_reponse_fiche"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_reponse_fiche_admin" model="ir.rule">
            <field name="name">L'administrateur voit toutes les réponses</field>
            <field name="model_id" ref="model_reponse_fiche"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

    </data>
</odoo>
