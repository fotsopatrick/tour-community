<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_site_genere_form" model="ir.ui.view">
        <field name="name">site.genere.form</field>
        <field name="model">site.genere</field>
        <field name="arch" type="xml">
            <form string="Site">
                <header>
                    <button name="action_generer" type="object" class="btn-primary"
                            string="Générer et mettre en ligne"/>
                    <button name="action_ouvrir" type="object"
                            string="Ouvrir le site" invisible="not url"/>
                    <field name="etat" widget="statusbar"
                           statusbar_visible="brouillon,en_ligne"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Vitrine PointVirgule"/></h1>
                        <field name="url" widget="url" readonly="1"
                               invisible="not url"/>
                    </div>
                    <group>
                        <field name="demande" nolabel="1"
                               placeholder="À qui s'adresse ce site, ce qu'il doit raconter, quel ton. Plus c'est précis, moins il faut recommencer."/>
                    </group>
                    <group col="4">
                        <field name="slug" readonly="1"/>
                        <field name="taille" readonly="1"/>
                        <field name="message" readonly="1" colspan="4"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        La page produite est <b>autonome</b> : un seul fichier, aucune
                        ressource extérieure. Elle continuera de fonctionner même si
                        un service tiers disparaît. Supprimer la fiche supprime aussi
                        le site.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_site_genere_list" model="ir.ui.view">
        <field name="name">site.genere.list</field>
        <field name="model">site.genere</field>
        <field name="arch" type="xml">
            <list string="Sites" decoration-success="etat == 'en_ligne'"
                  decoration-danger="etat == 'echec'">
                <field name="create_date" string="Créé"/>
                <field name="name"/>
                <field name="url" widget="url"/>
                <field name="etat"/>
                <field name="taille" optional="hide"/>
                <button name="action_ouvrir" type="object" string="Ouvrir"
                        icon="fa-external-link" invisible="not url"/>
            </list>
        </field>
    </record>

    <record id="action_site_genere" model="ir.actions.act_window">
        <field name="name">Sites générés</field>
        <field name="res_model">site.genere</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un premier site</p>
            <p>Décrivez le site que vous voulez, cliquez sur Générer, et vous
               obtenez une adresse vivante.</p>
        </field>
    </record>

    <menuitem id="menu_generateur_racine" name="Sites" sequence="75"/>
    <menuitem id="menu_generateur" name="Sites générés"
              parent="menu_generateur_racine" action="action_site_genere"/>
</odoo>
