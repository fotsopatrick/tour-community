<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Une photo par jour. Pas par heure : une pente se lit sur des semaines,
         et un relevé horaire ne ferait que du bruit dans l'historique. -->
    <record id="cron_tess" model="ir.cron">
        <field name="name">Tess : relever les chiffres</field>
        <field name="model_id" ref="model_tess_releve"/>
        <field name="state">code</field>
        <field name="code">model._cron_relever()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
