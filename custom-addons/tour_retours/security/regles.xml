<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Chacun voit ses retours, l'administrateur voit tout. Un testeur
             n'a pas à lire ce que les autres ont trouvé : il pourrait s'y
             reconnaître, ou pire, y lire une capture d'écran qui ne le
             regarde pas. -->
        <record id="regle_retour_perso" model="ir.rule">
            <field name="name">Ses propres retours</field>
            <field name="model_id" ref="model_bug_retour"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="regle_retour_admin" model="ir.rule">
            <field name="name">Tous les retours (admin)</field>
            <field name="model_id" ref="model_bug_retour"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
