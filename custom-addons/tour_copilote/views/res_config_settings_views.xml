<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.copilote</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Copilote IA" name="tour_copilote">
                    <block title="Connexion à Claude" name="copilote_connexion">
                        <setting string="Clé API Anthropic"
                                 help="Créée sur platform.claude.com (sk-ant-...). Stockée côté serveur uniquement — c'est elle qui permet au chat de répondre.">
                            <field name="copilote_api_key" password="True"/>
                        </setting>
                        <setting string="Modèle"
                                 help="claude-opus-4-8 par défaut (le plus capable). Changeable à tout moment.">
                            <field name="copilote_model"/>
                        </setting>
                    </block>
                    <block title="Notifications" name="copilote_notifications">
                        <setting string="Claude est de retour"
                                 help="Quand la limite d'abonnement se lève, un signal et son courriel te disent que tu peux recommencer — sans réessayer toutes les heures.">
                            <field name="copilote_notif_retour"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
