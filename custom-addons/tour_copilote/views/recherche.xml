<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="recherche" name="Recherche — Tour de Contrôle">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Recherche — Tour de Contrôle</title>
                <style>
                    body { background:var(--fond); color:var(--texte); margin:0;
                           font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
                    .wrap { max-width:820px; margin:0 auto; padding:26px 16px 56px; }
                    h1 { font-size:1.6rem; margin:0 0 4px; }
                    .sub { color:#94a3b8; margin:0 0 18px; }
                    form { display:flex; gap:8px; margin-bottom:20px; }
                    input[type=text] { flex:1; background:#0f172a; color:var(--texte); border:1px solid #1e293b;
                                       border-radius:8px; padding:10px 14px; font-size:1rem; }
                    button { background:#3b82f6; color:#fff; border:none; border-radius:8px; padding:10px 18px;
                             cursor:pointer; font-size:1rem; }
                    h2 { font-size:1rem; color:#7dd3fc; margin:24px 0 8px; border-bottom:1px solid #1e293b;
                         padding-bottom:4px; }
                    .r { display:block; background:#0f172a; border:1px solid #1e293b; border-radius:8px;
                         padding:9px 13px; margin:5px 0; text-decoration:none; color:#cbd5e1; font-size:.9rem; }
                    .r:hover { border-color:#3b82f6; }
                    .vide { color:#64748b; font-style:italic; font-size:.85rem; }
                </style>
<style>
:root{--fond:#020817;--surface:#0f172a;--surface2:#1e293b;--primaire:#3b82f6;--texte:#e2e8f0;--doux:#94a3b8;--alerte:#f59e0b;--ok:#22c55e;--r:.5rem;}
:root[data-theme="light"]{--fond:#EAEEF2;--surface:#FFFFFF;--surface2:#DDE4EB;--primaire:#2F6FB0;--texte:#14202B;--doux:#5C6B7A;--alerte:#B5651D;--ok:#1F8A46;--r:.5rem;}
</style>
<script>
(function(){var k="tour-theme",r=document.documentElement;try{var s=localStorage.getItem(k);if(s==="light"||s==="dark"){r.setAttribute("data-theme",s);}else{r.setAttribute("data-theme","light");}}catch(e){}var b=document.getElementById("themebtn");if(b){b.addEventListener("click",function(){var c=r.getAttribute("data-theme");if(!c){c="light";}var n=c==="dark"?"light":"dark";r.setAttribute("data-theme",n);try{localStorage.setItem(k,n);}catch(e){}});}})();
</script>

            </head>
            <body>
                <div class="wrap">
                    <h1>Recherche dans la tour</h1>
                    <p class="sub">Une requête, toutes les sources — tâches, guides, décisions, missions, réponses.</p>
                    <form method="get" action="/tour/recherche">
                        <input type="text" name="q" t-att-value="q" placeholder="Ex : circuits, purge, solde…"/>
                        <button type="submit">Chercher</button>
                    </form>
                    <t t-if="q">
                        <t t-foreach="resultats" t-as="cle" t-key="cle">
                            <t t-set="items" t-value="resultats[cle]"/>
                            <t t-if="items">
                                <h2><t t-esc="cle"/></h2>
                                <t t-foreach="items" t-as="r">
                                    <span class="r"><t t-esc="r['nom']"/></span>
                                </t>
                            </t>
                        </t>
                        <t t-if="not any(resultats.values())">
                            <p class="vide">Rien trouvé pour « <t t-esc="q"/> ».</p>
                        </t>
                    </t>
                    <t t-else="">
                        <p class="vide">Tape au moins 2 lettres.</p>
                    </t>
                </div>
            </body>
        </html>
    </template>
</odoo>
