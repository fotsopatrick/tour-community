# Tour de contrôle — édition Community
# Copiez ce fichier en `.env` et renseignez VOS valeurs. Aucun secret n'est
# fourni : la clé du Coffre (édition complète) n'est PAS dans cette édition.

# Postgres — à vous d'inventer un mot de passe fort
POSTGRES_PASSWORD=changez-moi
POSTGRES_USER=odoo

# Admin Odoo — protège la création/suppression de bases
ODOO_ADMIN_PASSWD=changez-moi

# Fuseau horaire
TZ=Europe/Paris

# Port de l'instance (ne pas exposer directement sur Internet)
ODOO_PORT=127.0.0.1:8071

# --- WebMCP (module tour_webmcp) ---
# Clé d'accès de l'endpoint MCP /mcp/tour (Authorization: Bearer <clé>).
# Posez-la aussi dans Réglages > WebMCP (paramètre tour_webmcp.api_key).
WEBMCP_KEY=changez-moi

# Clé Google Gemini (AI Studio) partagée par Chloé et Braignak quand leur
# moteur est réglé sur « gemini » (Réglages > WebMCP).
GEMINI_KEY=

# --- Google Cloud (deploy/cloudrun.sh) ---
# Chemin du fichier JSON du compte de service, id de projet, mot de passe
# racine de l'instance Cloud SQL.
SERVICE_ACCOUNT_JSON=chemin/vers/service-account.json
GOOGLE_CLOUD_PROJECT=mon-projet
PGROOT_PASSWORD=changez-moi